# Copy this file to .env.local. Leave keys empty to use local demonstration content.
# Never put API keys in NEXT_PUBLIC_* variables or commit .env.local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Use a DashScope key for the Beijing region.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com

# Project lifetime cloud-call budget in CNY. Code category caps: text 80 / ASR 5 / images 5.
# 90 CNY callable budget + 10 CNY planned contingency = 100 CNY demo envelope.
PROJECT_BUDGET_CNY=90

# Local services and files.
PORT=3000
DEMO_DB_PATH=data/local.db
PLAYWRIGHT_BROWSERS_PATH=data/browsers
KOKORO_MODEL_DIR=data/models/kokoro-multi-lang-v1_1
KOKORO_EN_SPEAKER=0
KOKORO_ZH_SPEAKER=3
KOKORO_THREADS=4
KOKORO_SPEED=0.94
KOKORO_PREWARM=true

# Windows can use installed System.Speech voices while Kokoro is not installed.
# This fallback is explicitly labelled demo-system-voice. Set false to require Kokoro.
ALLOW_DEMO_SYSTEM_VOICE=true

# Optional overrides; bundled FFmpeg/FFprobe are used when omitted.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe

# setup:voice does not load this file itself. For optional archive verification,
# set KOKORO_ARCHIVE_SHA256 in the shell environment before running the installer.
