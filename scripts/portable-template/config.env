# 小芽英语 Windows 便携包配置。修改后先停止再启动。
# 密钥留空即关闭对应云服务，不继承电脑环境中的同名密钥。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# 默认从 3000 起自动寻找空闲端口；仅允许本机访问。
PORT=3000
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com
PROJECT_BUDGET_CNY=90

# 语音、浏览器、数据库与 FFmpeg 固定使用包内路径，无需安装软件。
KOKORO_EN_SPEAKER=0
KOKORO_ZH_SPEAKER=3
KOKORO_THREADS=2
KOKORO_SPEED=0.94
KOKORO_PREWARM=true
